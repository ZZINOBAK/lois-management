<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lois.management.mapper.CakeMapper">

    <select id="findAllFlavors" resultType="String">
        SELECT flavor
        FROM cakes
        ORDER BY id
    </select>

    <select id="findAllIdFlavor" resultType="Cake">
        SELECT id, flavor
        FROM cakes
    </select>

    <select id="findFlavorsForDashboard" resultType="Cake">
        SELECT flavor_code AS code,
        flavor      AS name
        FROM cakes
        WHERE flavor_code IS NOT NULL
        ORDER BY MIN(id)
    </select>

</mapper>